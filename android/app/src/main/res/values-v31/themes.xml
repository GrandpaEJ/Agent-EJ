        <item name="android:windowBackground">#0E1013</item>
        <item name="android:statusBarColor">#14171C</item>
        <item name="android:navigationBarColor">#14171C</item>
        <item name="android:colorAccent">#3DDC84</item>
        <item name="android:windowSplashScreenBackground">#0E1013</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0E1013</item>
    </style>
</resources>
